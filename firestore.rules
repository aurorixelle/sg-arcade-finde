rules_version = '2';
// Paste into Firebase console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }

    // Arcade directory: public read, admin-only write
    match /arcades/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-user profile (favorites + admin flag). Owners can read their own doc
    // (read has no request.resource — that's write-only). On writes, users can
    // never grant themselves admin.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid
        && (!request.resource.data.hasOwnProperty('admin')
            || request.resource.data.admin == resource.data.admin);
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.hasOwnProperty('admin');
    }
  }
}
